<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="20dp"
    android:paddingTop="6dp">

    <EditText
        android:id="@+id/edt_habit_name"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:background="@drawable/bg_rounded_input"
        android:hint="Tên thói quen (vd: Uống đủ nước)"
        android:paddingHorizontal="16dp"
        android:textColor="@color/colorTextPrimary"
        android:textColorHint="@color/colorTextHint"
        android:textSize="15sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Biểu tượng"
        android:textColor="@color/colorTextSecondary"
        android:textSize="13sp"
        android:textStyle="bold" />

    <com.google.android.material.chip.ChipGroup
        android:id="@+id/chip_group_habit_emoji"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        app:selectionRequired="true"
        app:singleSelection="true">

        <com.google.android.material.chip.Chip
            android:id="@+id/chip_emoji_water"
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="💧" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chip_emoji_book"
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📚" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chip_emoji_run"
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🏃" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chip_emoji_meditate"
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🧘" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chip_emoji_sleep"
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🌙" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chip_emoji_food"
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🥗" />
    </com.google.android.material.chip.ChipGroup>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Mẹo: chạm vào thói quen mỗi ngày để giữ chuỗi 🔥"
        android:textColor="@color/colorTextHint"
        android:textSize="12sp" />
</LinearLayout>
