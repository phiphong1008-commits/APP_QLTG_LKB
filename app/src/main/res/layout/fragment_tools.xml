<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground">

    <LinearLayout
        android:id="@+id/header_tools"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp"
        android:paddingVertical="8dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/btn_back_tools"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Quay lại"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/colorTextPrimary" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Khám phá tính năng"
                android:textColor="@color/colorTextPrimary"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Những công cụ giúp bạn làm việc hiệu quả hơn"
                android:textColor="@color/colorTextSecondary"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingBottom="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/header_tools">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="14dp"
            android:paddingTop="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_marginTop="6dp"
                android:text="P1 • Nâng cấp trải nghiệm"
                android:textColor="@color/colorTextSecondary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:columnCount="2">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_tool_week"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="112dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="6dp"
                    android:gravity="center"
                    android:text="Lịch tuần"
                    android:textAllCaps="false"
                    android:textColor="@color/colorTextPrimary"
                    android:textSize="14sp"
                    app:backgroundTint="@color/colorCard"
                    app:cornerRadius="18dp"
                    app:icon="@drawable/ic_calendar"
                    app:iconGravity="textTop"
                    app:iconPadding="8dp"
                    app:iconSize="26dp"
                    app:iconTint="@color/colorPrimary"
                    app:strokeColor="@color/colorInputBorder"
                    app:strokeWidth="1dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_tool_quick_add"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="112dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="6dp"
                    android:gravity="center"
                    android:text="Thêm nhanh"
                    android:textAllCaps="false"
                    android:textColor="@color/colorTextPrimary"
                    android:textSize="14sp"
                    app:backgroundTint="@color/colorCard"
                    app:cornerRadius="18dp"
                    app:icon="@drawable/ic_sparkle"
                    app:iconGravity="textTop"
                    app:iconPadding="8dp"
                    app:iconSize="26dp"
                    app:iconTint="@color/colorAccent"
                    app:strokeColor="@color/colorInputBorder"
                    app:strokeWidth="1dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_tool_focus"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="112dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="6dp"
                    android:gravity="center"
                    android:text="Tập trung"
                    android:textAllCaps="false"
                    android:textColor="@color/colorTextPrimary"
                    android:textSize="14sp"
                    app:backgroundTint="@color/colorCard"
                    app:cornerRadius="18dp"
                    app:icon="@drawable/ic_timer"
                    app:iconGravity="textTop"
                    app:iconPadding="8dp"
                    app:iconSize="26dp"
                    app:iconTint="@color/colorPrimary"
                    app:strokeColor="@color/colorInputBorder"
                    app:strokeWidth="1dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_tool_habits"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="112dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="6dp"
                    android:gravity="center"
                    android:text="Thói quen"
                    android:textAllCaps="false"
                    android:textColor="@color/colorTextPrimary"
                    android:textSize="14sp"
                    app:backgroundTint="@color/colorCard"
                    app:cornerRadius="18dp"
                    app:icon="@drawable/ic_check_circle"
                    app:iconGravity="textTop"
                    app:iconPadding="8dp"
                    app:iconSize="26dp"
                    app:iconTint="@color/colorSuccess"
                    app:strokeColor="@color/colorInputBorder"
                    app:strokeWidth="1dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_tool_stats"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="112dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="6dp"
                    android:gravity="center"
                    android:text="Thống kê"
                    android:textAllCaps="false"
                    android:textColor="@color/colorTextPrimary"
                    android:textSize="14sp"
                    app:backgroundTint="@color/colorCard"
                    app:cornerRadius="18dp"
                    app:icon="@drawable/ic_chart"
                    app:iconGravity="textTop"
                    app:iconPadding="8dp"
                    app:iconSize="26dp"
                    app:iconTint="@color/colorPrimary"
                    app:strokeColor="@color/colorInputBorder"
                    app:strokeWidth="1dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_tool_matrix"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="112dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="6dp"
                    android:gravity="center"
                    android:text="Ma trận Eisenhower"
                    android:textAllCaps="false"
                    android:textColor="@color/colorTextPrimary"
                    android:textSize="14sp"
                    app:backgroundTint="@color/colorCard"
                    app:cornerRadius="18dp"
                    app:icon="@drawable/ic_matrix"
                    app:iconGravity="textTop"
                    app:iconPadding="8dp"
                    app:iconSize="26dp"
                    app:iconTint="@color/colorWarning"
                    app:strokeColor="@color/colorInputBorder"
                    app:strokeWidth="1dp" />
            </GridLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_marginTop="18dp"
                android:text="P2 • Cá nhân hoá &amp; cộng tác"
                android:textColor="@color/colorTextSecondary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:columnCount="2">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_tool_templates"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="112dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="6dp"
                    android:gravity="center"
                    android:text="Mẫu công việc"
                    android:textAllCaps="false"
                    android:textColor="@color/colorTextPrimary"
                    android:textSize="14sp"
                    app:backgroundTint="@color/colorCard"
                    app:cornerRadius="18dp"
                    app:icon="@drawable/ic_note"
                    app:iconGravity="textTop"
                    app:iconPadding="8dp"
                    app:iconSize="26dp"
                    app:iconTint="@color/colorPrimary"
                    app:strokeColor="@color/colorInputBorder"
                    app:strokeWidth="1dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_tool_achievements"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="112dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="6dp"
                    android:gravity="center"
                    android:text="Thành tích"
                    android:textAllCaps="false"
                    android:textColor="@color/colorTextPrimary"
                    android:textSize="14sp"
                    app:backgroundTint="@color/colorCard"
                    app:cornerRadius="18dp"
                    app:icon="@drawable/ic_trophy"
                    app:iconGravity="textTop"
                    app:iconPadding="8dp"
                    app:iconSize="26dp"
                    app:iconTint="@color/colorWarning"
                    app:strokeColor="@color/colorInputBorder"
                    app:strokeWidth="1dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_tool_assistant"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="112dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="6dp"
                    android:gravity="center"
                    android:text="Trợ lý AI"
                    android:textAllCaps="false"
                    android:textColor="@color/colorTextPrimary"
                    android:textSize="14sp"
                    app:backgroundTint="@color/colorCard"
                    app:cornerRadius="18dp"
                    app:icon="@drawable/ic_sparkle"
                    app:iconGravity="textTop"
                    app:iconPadding="8dp"
                    app:iconSize="26dp"
                    app:iconTint="@color/colorAccent"
                    app:strokeColor="@color/colorInputBorder"
                    app:strokeWidth="1dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_tool_groups"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="112dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="6dp"
                    android:gravity="center"
                    android:text="Nhóm &amp; gia đình"
                    android:textAllCaps="false"
                    android:textColor="@color/colorTextPrimary"
                    android:textSize="14sp"
                    app:backgroundTint="@color/colorCard"
                    app:cornerRadius="18dp"
                    app:icon="@drawable/ic_share"
                    app:iconGravity="textTop"
                    app:iconPadding="8dp"
                    app:iconSize="26dp"
                    app:iconTint="@color/colorPrimary"
                    app:strokeColor="@color/colorInputBorder"
                    app:strokeWidth="1dp" />
            </GridLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="6dp"
                android:layout_marginTop="18dp"
                android:background="@drawable/bg_pill_neutral"
                android:padding="14dp"
                android:text="Mẹo: nhấn giữ một công việc để dời ngày, thêm vào Google Calendar, chia sẻ hoặc lưu thành mẫu."
                android:textColor="@color/colorTextSecondary"
                android:textSize="12sp" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
