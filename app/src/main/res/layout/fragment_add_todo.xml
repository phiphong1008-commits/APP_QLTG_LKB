<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground">

    <LinearLayout
        android:id="@+id/header_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/colorBackground"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp"
        android:paddingVertical="8dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Quay lại màn hình trước"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/colorTextPrimary" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_header_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Công việc"
                android:textColor="@color/colorTextPrimary"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sắp xếp một việc cần làm"
                android:textColor="@color/colorTextSecondary"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/header_layout">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="4dp"
            android:paddingBottom="24dp">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/colorInputBorder"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Thông tin công việc"
                        android:textColor="@color/colorTextPrimary"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:text="Tên công việc *"
                        android:textColor="@color/colorTextSecondary"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/edt_task_title"
                        android:layout_width="match_parent"
                        android:layout_height="54dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_rounded_input"
                        android:hint="Vd: Mua sữa, Làm bài tập..."
                        android:paddingHorizontal="16dp"
                        android:textColor="@color/colorTextPrimary"
                        android:textColorHint="@color/colorTextHint"
                        android:textSize="15sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:text="Loại công việc"
                        android:textColor="@color/colorTextSecondary"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:scrollbars="none">

                        <RadioGroup
                            android:id="@+id/rg_task_icons"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <RadioButton
                                android:id="@+id/rb_icon_study"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="10dp"
                                android:background="@drawable/selector_icon_bg"
                                android:button="@null"
                                android:drawableTop="@drawable/ic_book"
                                android:drawablePadding="6dp"
                                android:drawableTint="@color/icon_tint_color"
                                android:gravity="center"
                                android:minWidth="78dp"
                                android:minHeight="72dp"
                                android:padding="10dp"
                                android:text="Học tập"
                                android:textColor="@color/icon_label_color"
                                android:textSize="12sp" />

                            <RadioButton
                                android:id="@+id/rb_icon_work"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="10dp"
                                android:background="@drawable/selector_icon_bg"
                                android:button="@null"
                                android:checked="true"
                                android:drawableTop="@drawable/ic_work"
                                android:drawablePadding="6dp"
                                android:drawableTint="@color/icon_tint_color"
                                android:gravity="center"
                                android:minWidth="78dp"
                                android:minHeight="72dp"
                                android:padding="10dp"
                                android:text="Công việc"
                                android:textColor="@color/icon_label_color"
                                android:textSize="12sp" />

                            <RadioButton
                                android:id="@+id/rb_icon_home"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="10dp"
                                android:background="@drawable/selector_icon_bg"
                                android:button="@null"
                                android:drawableTop="@drawable/ic_home"
                                android:drawablePadding="6dp"
                                android:drawableTint="@color/icon_tint_color"
                                android:gravity="center"
                                android:minWidth="78dp"
                                android:minHeight="72dp"
                                android:padding="10dp"
                                android:text="Nhà cửa"
                                android:textColor="@color/icon_label_color"
                                android:textSize="12sp" />

                            <RadioButton
                                android:id="@+id/rb_icon_event"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@drawable/selector_icon_bg"
                                android:button="@null"
                                android:drawableTop="@drawable/ic_event"
                                android:drawablePadding="6dp"
                                android:drawableTint="@color/icon_tint_color"
                                android:gravity="center"
                                android:minWidth="78dp"
                                android:minHeight="72dp"
                                android:padding="10dp"
                                android:text="Sự kiện"
                                android:textColor="@color/icon_label_color"
                                android:textSize="12sp" />
                        </RadioGroup>
                    </HorizontalScrollView>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:text="Mô tả chi tiết"
                        android:textColor="@color/colorTextSecondary"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/edt_task_desc"
                        android:layout_width="match_parent"
                        android:layout_height="104dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_rounded_input"
                        android:gravity="top|start"
                        android:hint="Ghi chú thêm cho công việc này..."
                        android:inputType="textMultiLine"
                        android:padding="16dp"
                        android:textColor="@color/colorTextPrimary"
                        android:textColorHint="@color/colorTextHint"
                        android:textSize="15sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/colorInputBorder"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Thời gian &amp; ưu tiên"
                        android:textColor="@color/colorTextPrimary"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:baselineAligned="false"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="6dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Ngày thực hiện"
                                android:textColor="@color/colorTextSecondary"
                                android:textSize="13sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tv_task_date"
                                android:layout_width="match_parent"
                                android:layout_height="54dp"
                                android:layout_marginTop="8dp"
                                android:background="@drawable/bg_rounded_input"
                                android:drawableStart="@drawable/ic_calendar"
                                android:drawablePadding="8dp"
                                android:drawableTint="@color/colorPrimary"
                                android:gravity="center_vertical"
                                android:paddingHorizontal="14dp"
                                android:text="Chọn ngày"
                                android:textColor="@color/colorPrimary"
                                android:textSize="14sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Thời gian"
                                android:textColor="@color/colorTextSecondary"
                                android:textSize="13sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tv_task_time"
                                android:layout_width="match_parent"
                                android:layout_height="54dp"
                                android:layout_marginTop="8dp"
                                android:background="@drawable/bg_rounded_input"
                                android:drawableStart="@drawable/ic_clock"
                                android:drawablePadding="8dp"
                                android:drawableTint="@color/colorPrimary"
                                android:gravity="center_vertical"
                                android:paddingHorizontal="14dp"
                                android:text="Chọn giờ"
                                android:textColor="@color/colorPrimary"
                                android:textSize="14sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:text="Mức độ ưu tiên"
                        android:textColor="@color/colorTextSecondary"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <RadioGroup
                        android:id="@+id/rg_priority"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal">

                        <RadioButton
                            android:id="@+id/rb_low"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_marginEnd="6dp"
                            android:layout_weight="1"
                            android:background="@drawable/selector_priority_chip"
                            android:button="@null"
                            android:drawableStart="@drawable/dot_low"
                            android:drawablePadding="6dp"
                            android:gravity="center"
                            android:text="Thấp"
                            android:textColor="@color/priority_text_color"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <RadioButton
                            android:id="@+id/rb_medium"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_marginHorizontal="6dp"
                            android:layout_weight="1"
                            android:background="@drawable/selector_priority_chip"
                            android:button="@null"
                            android:checked="true"
                            android:drawableStart="@drawable/dot_medium"
                            android:drawablePadding="6dp"
                            android:gravity="center"
                            android:text="Vừa"
                            android:textColor="@color/priority_text_color"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <RadioButton
                            android:id="@+id/rb_high"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_marginStart="6dp"
                            android:layout_weight="1"
                            android:background="@drawable/selector_priority_chip"
                            android:button="@null"
                            android:drawableStart="@drawable/dot_high"
                            android:drawablePadding="6dp"
                            android:gravity="center"
                            android:text="Cao"
                            android:textColor="@color/priority_text_color"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                    </RadioGroup>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_save_task"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="22dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="Lưu công việc"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold"
                app:backgroundTint="@color/colorPrimary"
                app:cornerRadius="16dp"
                app:icon="@drawable/ic_check_circle"
                app:iconGravity="textStart"
                app:iconPadding="8dp"
                app:iconTint="@color/white" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
