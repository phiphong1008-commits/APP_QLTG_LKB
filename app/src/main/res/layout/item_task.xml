<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/card_task_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="20dp"
    android:layout_marginVertical="6dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    app:cardBackgroundColor="@color/white"
    app:cardCornerRadius="18dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/colorInputBorder"
    app:strokeWidth="1dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="14dp">

        <View
            android:id="@+id/view_priority_indicator"
            android:layout_width="6dp"
            android:layout_height="0dp"
            android:background="@drawable/bg_pill_medium"
            app:layout_constraintBottom_toBottomOf="@+id/tv_task_desc"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/iv_task_icon" />

        <ImageView
            android:id="@+id/iv_task_icon"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_icon_tile"
            android:contentDescription="Loại công việc"
            android:padding="10dp"
            android:src="@drawable/ic_work"
            app:layout_constraintStart_toEndOf="@+id/view_priority_indicator"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/colorPrimary" />

        <CheckBox
            android:id="@+id/cb_task_status"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:buttonTint="@color/checkbox_tint"
            app:layout_constraintBottom_toBottomOf="@+id/iv_task_icon"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/iv_task_icon" />

        <TextView
            android:id="@+id/tv_task_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="4dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:text="Tiêu đề công việc"
            android:textColor="@color/colorTextPrimary"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="@+id/iv_task_icon"
            app:layout_constraintEnd_toStartOf="@+id/cb_task_status"
            app:layout_constraintStart_toEndOf="@+id/iv_task_icon"
            app:layout_constraintTop_toTopOf="@+id/iv_task_icon" />

        <LinearLayout
            android:id="@+id/layout_task_meta"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="2dp"
            android:layout_marginEnd="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:layout_constraintEnd_toStartOf="@+id/cb_task_status"
            app:layout_constraintStart_toEndOf="@+id/iv_task_icon"
            app:layout_constraintTop_toBottomOf="@+id/iv_task_icon">

            <ImageView
                android:id="@+id/iv_task_time_icon"
                android:layout_width="13dp"
                android:layout_height="13dp"
                android:contentDescription="Thời gian"
                android:src="@drawable/ic_clock"
                app:tint="@color/colorTextSecondary" />

            <TextView
                android:id="@+id/tv_task_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:maxLines="1"
                android:text="08:00"
                android:textColor="@color/colorTextSecondary"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tv_task_priority"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_pill_medium"
                android:paddingHorizontal="8dp"
                android:paddingVertical="2dp"
                android:text="Vừa"
                android:textColor="@color/priorityMedium"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_task_desc"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="4dp"
            android:layout_marginEnd="4dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:text="Mô tả chi tiết công việc..."
            android:textColor="@color/colorTextSecondary"
            android:textSize="13sp"
            app:layout_constraintEnd_toStartOf="@+id/cb_task_status"
            app:layout_constraintStart_toEndOf="@+id/iv_task_icon"
            app:layout_constraintTop_toBottomOf="@+id/layout_task_meta" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
