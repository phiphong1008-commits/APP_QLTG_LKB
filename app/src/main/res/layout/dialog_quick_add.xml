<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="20dp"
    android:paddingTop="6dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Gõ tự nhiên, ứng dụng tự nhận diện ngày, giờ, ưu tiên và danh sách."
        android:textColor="@color/colorTextSecondary"
        android:textSize="12sp" />

    <EditText
        android:id="@+id/edt_quick_add"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_rounded_input"
        android:gravity="top|start"
        android:hint="Vd: Họp nhóm 9h mai !cao #Công việc"
        android:inputType="textCapSentences|textMultiLine"
        android:minHeight="88dp"
        android:padding="14dp"
        android:textColor="@color/colorTextPrimary"
        android:textColorHint="@color/colorTextHint"
        android:textSize="15sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_quick_voice"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="Nói"
            android:textAllCaps="false"
            android:textColor="@color/colorPrimary"
            app:backgroundTint="@color/colorPrimaryContainer"
            app:cornerRadius="14dp"
            app:icon="@drawable/ic_mic"
            app:iconPadding="6dp"
            app:iconTint="@color/colorPrimary"
            app:strokeWidth="0dp" />

        <TextView
            android:id="@+id/tv_quick_hint"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:text="!cao !thấp  •  #danh sách  •  mai, thứ 2"
            android:textColor="@color/colorTextHint"
            android:textSize="11sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tv_quick_preview"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_pill_neutral"
        android:padding="12dp"
        android:text="📅 Hôm nay"
        android:textColor="@color/colorTextSecondary"
        android:textSize="12sp" />

</LinearLayout>
